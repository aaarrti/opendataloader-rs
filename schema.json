{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/opendataloader-project/opendataloader-pdf/main/schema.json",
  "title": "OpenDataLoader PDF Output",
  "description": "JSON output produced by the Rust PDF converter.",
  "type": "object",
  "required": [
    "file name",
    "number of pages",
    "author",
    "title",
    "creation date",
    "modification date",
    "kids"
  ],
  "properties": {
    "file name": { "type": "string" },
    "number of pages": { "type": "integer", "minimum": 0 },
    "author": { "type": ["string", "null"] },
    "title": { "type": ["string", "null"] },
    "creation date": { "type": ["string", "null"] },
    "modification date": { "type": ["string", "null"] },
    "kids": {
      "type": "array",
      "items": { "$ref": "#/$defs/element" }
    }
  },
  "$defs": {
    "boundingBox": {
      "type": "array",
      "items": { "type": "number" },
      "minItems": 4,
      "maxItems": 4
    },
    "commonElement": {
      "type": "object",
      "properties": {
        "type": { "type": "string" },
        "pdfua_tag": { "type": "string" },
        "id": { "type": "integer", "minimum": 1 },
        "page number": { "type": "integer", "minimum": 1 },
        "bounding box": { "$ref": "#/$defs/boundingBox" }
      },
      "required": ["type", "page number", "bounding box"]
    },
    "textFields": {
      "type": "object",
      "properties": {
        "font": { "type": ["string", "null"] },
        "font size": { "type": ["number", "null"] },
        "text color": {
          "type": "array",
          "items": { "type": "number" }
        },
        "content": { "type": "string" }
      },
      "required": ["font", "font size", "content"]
    },
    "element": {
      "oneOf": [
        { "$ref": "#/$defs/heading" },
        { "$ref": "#/$defs/paragraph" },
        { "$ref": "#/$defs/textChunk" },
        { "$ref": "#/$defs/textBlock" },
        { "$ref": "#/$defs/formula" },
        { "$ref": "#/$defs/image" },
        { "$ref": "#/$defs/caption" },
        { "$ref": "#/$defs/list" },
        { "$ref": "#/$defs/listItem" },
        { "$ref": "#/$defs/table" },
        { "$ref": "#/$defs/tableRow" },
        { "$ref": "#/$defs/tableCell" },
        { "$ref": "#/$defs/toc" },
        { "$ref": "#/$defs/tocItem" }
      ]
    },
    "heading": {
      "allOf": [
        { "$ref": "#/$defs/commonElement" },
        { "$ref": "#/$defs/textFields" },
        {
          "type": "object",
          "properties": {
            "type": { "const": "heading" },
            "heading level": { "type": "integer", "minimum": 1 }
          },
          "required": ["heading level"]
        }
      ]
    },
    "paragraph": {
      "allOf": [
        { "$ref": "#/$defs/commonElement" },
        { "$ref": "#/$defs/textFields" },
        { "properties": { "type": { "const": "paragraph" } } }
      ]
    },
    "textChunk": {
      "allOf": [
        { "$ref": "#/$defs/commonElement" },
        { "$ref": "#/$defs/textFields" },
        { "properties": { "type": { "const": "text chunk" } } }
      ]
    },
    "textBlock": {
      "allOf": [
        { "$ref": "#/$defs/commonElement" },
        { "$ref": "#/$defs/textFields" },
        { "properties": { "type": { "const": "text block" } } }
      ]
    },
    "formula": {
      "allOf": [
        { "$ref": "#/$defs/commonElement" },
        {
          "type": "object",
          "properties": {
            "type": { "const": "formula" },
            "content": { "type": "string" }
          },
          "required": ["content"]
        }
      ]
    },
    "image": {
      "allOf": [
        { "$ref": "#/$defs/commonElement" },
        {
          "type": "object",
          "properties": {
            "type": { "const": "image" },
            "alt_source": { "const": "missing" },
            "source": { "type": "string" },
            "data": { "type": "string" },
            "format": { "enum": ["png", "jpeg"] }
          },
          "required": ["alt_source"]
        }
      ]
    },
    "caption": {
      "allOf": [
        { "$ref": "#/$defs/commonElement" },
        { "$ref": "#/$defs/textFields" },
        {
          "type": "object",
          "properties": {
            "type": { "const": "caption" },
            "linked content id": { "type": "integer", "minimum": 1 }
          }
        }
      ]
    },
    "list": {
      "allOf": [
        { "$ref": "#/$defs/commonElement" },
        {
          "type": "object",
          "properties": {
            "type": { "const": "list" },
            "numbering style": { "enum": ["ordered", "unordered"] },
            "number of list items": { "type": "integer", "minimum": 0 },
            "list items": {
              "type": "array",
              "items": { "$ref": "#/$defs/listItem" }
            }
          },
          "required": ["numbering style", "number of list items", "list items"]
        }
      ]
    },
    "listItem": {
      "allOf": [
        { "$ref": "#/$defs/commonElement" },
        {
          "type": "object",
          "properties": {
            "type": { "const": "list item" },
            "content": { "type": "string" },
            "kids": {
              "type": "array",
              "items": { "$ref": "#/$defs/element" }
            }
          },
          "required": ["kids"]
        }
      ]
    },
    "table": {
      "allOf": [
        { "$ref": "#/$defs/commonElement" },
        {
          "type": "object",
          "properties": {
            "type": { "const": "table" },
            "number of rows": { "type": "integer", "minimum": 0 },
            "number of columns": { "type": "integer", "minimum": 0 },
            "rows": {
              "type": "array",
              "items": { "$ref": "#/$defs/tableRow" }
            }
          },
          "required": ["number of rows", "number of columns", "rows"]
        }
      ]
    },
    "tableRow": {
      "type": "object",
      "properties": {
        "type": { "const": "table row" },
        "id": { "type": "integer", "minimum": 1 },
        "row number": { "type": "integer", "minimum": 1 },
        "cells": {
          "type": "array",
          "items": { "$ref": "#/$defs/tableCell" }
        }
      },
      "required": ["type", "row number", "cells"]
    },
    "tableCell": {
      "allOf": [
        { "$ref": "#/$defs/commonElement" },
        {
          "type": "object",
          "properties": {
            "type": { "const": "table cell" },
            "row number": { "type": "integer", "minimum": 1 },
            "column number": { "type": "integer", "minimum": 1 },
            "row span": { "type": "integer", "minimum": 1 },
            "column span": { "type": "integer", "minimum": 1 },
            "is_header": { "const": true },
            "kids": {
              "type": "array",
              "items": { "$ref": "#/$defs/element" }
            }
          },
          "required": ["row number", "column number", "row span", "column span", "kids"]
        }
      ]
    },
    "toc": {
      "allOf": [
        { "$ref": "#/$defs/commonElement" },
        {
          "type": "object",
          "properties": {
            "type": { "const": "toc" },
            "toc items": {
              "type": "array",
              "items": { "$ref": "#/$defs/tocItem" }
            }
          },
          "required": ["toc items"]
        }
      ]
    },
    "tocItem": {
      "allOf": [
        { "$ref": "#/$defs/commonElement" },
        { "$ref": "#/$defs/textFields" },
        {
          "type": "object",
          "properties": {
            "type": { "const": "toc item" },
            "kids": {
              "type": "array",
              "items": { "$ref": "#/$defs/element" }
            }
          },
          "required": ["kids"]
        }
      ]
    }
  }
}
